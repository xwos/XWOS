{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rpi4b-AllCores-Openocd-Jlink-Launch",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "servertype": "openocd",
            "interface": "jtag",
            "targetProcessor": 0,
            "numberOfProcessors": 4,
            "configFiles": [
                "xwbd/RPi4B/debug/openocd/jlink.cfg"
            ],
            "device": "BCM2711",
            "svdFile": "xwbd/RPi4B/debug/bcm2711_lpa.svd",
            "executable": "xwbd/RPi4B/WKSPC/XWOS.elf",
            "runToEntryPoint": "soc_init",
            "armToolchainPath": "${env:XWTC}/arm/bin",
            "gdbPath": "${env:XWTC}/arm/bin/aarch64-none-elf-gdb",
            "serverLaunchTimeout": 100000,
            "preLaunchCommands": [
                "mon adapter speed 4000",
                "set remote hardware-breakpoint-limit 6",
                "set remote hardware-watchpoint-limit 4"
            ],
            "chainedConfigurations": {
                "enabled": true,
                "detached": true,
                "waitOnEvent": "postInit",
                "lifecycleManagedByParent": true,
                "launches": [
                    {
                        "name": "Rpi4b-Core1-Openocd-Attach",
                        "folder": "${workspaceFolder}"
                    },
                    {
                        "name": "Rpi4b-Core2-Openocd-Attach",
                        "folder": "${workspaceFolder}"
                    },
                    {
                        "name": "Rpi4b-Core3-Openocd-Attach",
                        "folder": "${workspaceFolder}"
                    }
                ]
            }
        },
